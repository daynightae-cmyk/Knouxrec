# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# Build and audit output. The unpacked runtime under release/ is what the
# packaged smokes launch, so it is kept locally but never committed.
release
release-fresh
release-next
release-g*
# Packaging output for the real-hardware acceptance build. It is a rebuild of
# the same source that CI already packages, and it is kept on disk rather than
# deleted so the binary stays available for testing; it is not source.
release-hw
asar-stage
.asar-stage
artifacts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Packed application archives produced while repacking the bundle
*.asar

# Vitest temporary timestamp files generated during test runs
vitest.config.ts.timestamp-*
